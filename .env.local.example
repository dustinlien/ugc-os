# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon public key (safe for the browser; RLS still applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the client. Used for embedding writes if needed.
SUPABASE_SERVICE_ROLE_KEY=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Chat model. Default is a cheap Gemini Flash-class model.
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash

# Embedding model. Dimension must match guideline_chunks.embedding (1536 for this model).
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
